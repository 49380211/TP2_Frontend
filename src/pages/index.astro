---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
const refreshToken = Astro.cookies.get('sb-refresh-token')?.value;

if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
  if (data?.user) return Astro.redirect('/catalog');
}
---

<Layout title="Inicio">
  <section class="hero">
    <div class="container hero-content animate-in">
      <div class="hero-eyebrow">Tu colección personal</div>
      <h1 class="hero-title">CADA PELÍCULA<br/><span>TIENE SU LUGAR</span></h1>
      <p class="hero-sub">Organizá, puntuá y descubrí tu cine. Un catálogo personal donde cada film que viste —o querés ver— vive en un solo lugar.</p>
      <div class="hero-cta">
        <a href="/register" class="btn btn-primary btn-lg">Crear mi catálogo</a>
        <a href="/login" class="btn btn-ghost btn-lg">Ya tengo cuenta</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.hero { padding-bottom: 4rem; }
.hero-content { padding: 6rem 1.5rem 3rem; max-width: 700px; }
.hero-eyebrow { font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
.hero-title { font-family: var(--font-display); font-size: clamp(3.5rem, 8vw, 6rem); line-height: 0.95; letter-spacing: 0.02em; margin-bottom: 1.5rem; }
.hero-title span { color: var(--accent); }
.hero-sub { font-size: 1.1rem; color: var(--text-muted); max-width: 480px; margin-bottom: 2.5rem; }
.hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }
.btn-lg { padding: 0.85rem 2rem; font-size: 1rem; }
</style>
